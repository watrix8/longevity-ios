    "Wiek, płeć, wzrost i waga wchodzą wprost do wyniku. Bez nich policzymy go z połowy składników.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiek, płeć, wzrost i waga wchodzą wprost do wyniku. Bez nich policzymy go z połowy składników."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age, sex, height and weight feed straight into your score. Without them we compute it from half the inputs."
          }
        }
      }
    },
    "Więcej energii": {
