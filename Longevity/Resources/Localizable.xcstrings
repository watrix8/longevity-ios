    "Wiek, płeć, wzrost i waga wchodzą wprost do wyniku. Bez nich policzymy go z połowy składników." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Age, sex, height and weight feed the score directly. Without them we calculate it from half the components."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiek, płeć, wzrost i waga wchodzą wprost do wyniku. Bez nich policzymy go z połowy składników."
          }
        }
      }
    },
    "Wolę nie podawać" : {
